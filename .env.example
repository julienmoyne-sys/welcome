# Serveur SMTP (ne jamais préfixer ces variables avec NEXT_PUBLIC_)
SMTP_PASSWORD=
SMTP_HOST=pro1.mail.ovh.net
SMTP_PORT=587
SMTP_USER=contact@welcome-coworking.com

# Clé serveur privée Stancer : stest_... en local, sprod_... en production
STANCER_API_KEY=
# Secret hexadécimal retourné lors de la création du webhook Stancer
STANCER_WEBHOOK_SECRET=

# Écran d'affichage
GOOGLE_CALENDAR_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
